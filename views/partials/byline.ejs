<p class="byline">
    <%- include("./author.ejs", { author: post.author, showAvatar: false }) %>
    <span aria-hidden="true">·</span>
    <time datetime="<%= post.createdAt.toISOString().slice(0, 10) %>"><%= post.createdAt.toLocaleDateString("en-GB", { dateStyle: "medium" }) %></time>
    <% if (post.isPrivate) { %>
        <span aria-hidden="true">·</span>
        <span class="badge-private">Only me</span>
    <% } %>
</p>