<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dear Me</title>

    <!--Meta tags - TODO-->
    <meta name="robots" content="noindex, nofollow">
    <meta name="description" content="A quiet place to put your thoughts into words.">
    <meta name="theme-color" content="#F5EBDD">
    <meta name="color-scheme" content="light">
    <link rel="icon" href="/images/assets/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/images/assets/favicon.png">

    <!--Fonts-->
    <link rel="stylesheet" href="/fonts/fraunces/wght.css">
    <link rel="stylesheet" href="/fonts/fraunces/wght-italic.css">
    <link rel="stylesheet" href="/fonts/nunito/wght.css">
    <link rel="stylesheet" href="/fonts/nunito/wght-italic.css">

    <!--CSS Stylesheet-->
    <link href="/css/styles-final.css" rel="stylesheet">


</head>
<body>
    
    <!--header-->
    <header class="site-header container">
        <a href="/"><img src="/images/assets/blog-logo.svg" alt="Dear Me," class="logo"></a>
        
        <nav class="site-nav">
            <a href="/" <%- currentPath === "/" ? 'aria-current="page"' : "" %>>Home</a>
            <a href="/about" <%- currentPath === "/about" ? 'aria-current="page"' : "" %>>About</a>
            
            <% if (currentUser) { %>

                <% if (currentUser.isAdmin) { %>
                    <a href="/admin/reports" <%- currentPath === "/admin/reports" ? 'aria-current="page"' : "" %>>Reports</a>
                <% } %>

                <a href="/compose" <%- currentPath === "/compose" ? 'aria-current="page"' : "" %>>Write</a>
                

                <div class="nav-account">
                    <div class="nav-user">
                        <% if(currentUser.avatar) { %>
                            <a href="/me" aria-label="My profile"><img src="<%= currentUser.avatar.image %>" alt="" class="nav-avatar"></a>
                        <% } %>
                        <span class="nav-pseudonym"><%= currentUser.pseudonym %></span>
                    </div>
                </div>

                <form action="/logout" method="POST" class="logout-form">
                    <button type="submit" class="nav-button">Log out</button>
                </form>
            <% } else { %>
                <a href="/login" <%- currentPath === "/login" ? 'aria-current="page"' : "" %>>Log in</a>
                <a href="/register" <%- currentPath === "/register" ? 'aria-current="page"' : "" %>>Register</a>
            <% } %>
        </nav>
    </header>

    <main class="container">
