<%- include("./partials/header.ejs") %>

<section class="intro">
  <h1>Food for thought</h1>
  <p><%= quote %></p>
</section>

<img class="divider" src="/images/logo-and-dividers/divider.svg" alt="">

<form class="search" action="/" method="GET" role="search">
    <input type="search" name="q" value="<%= q %>" maxlength="100" aria-label="Search posts" placeholder="Search thoughts">
    <% if (activeMood) { %> <input type="hidden" name="mood" value="<%= activeMood.slug %>"> <% } %>
    <% if (activeTag) { %> <input type="hidden" name="tag" value="<%= activeTag.slug %>"> <% } %>
    <button type="submit" class="btn">Search</button>
</form>

<details class="filter-panel">
    <summary>Filter by feelings</summary>

    <div class="mood-filter">
        <a class="chip" href="/" <%- !activeMood ? 'aria-current="page"' : "" %>>All</a>
        <% moods.forEach(mood => { %>
            <a class="chip" href="/?mood=<%= mood.slug %><%= activeTag ? '&tag=' + activeTag.slug : '' %>" <%- activeMood && activeMood.slug === mood.slug ? 'aria-current="page"' : "" %>>
                <img class="chip__sticker" src="<%= mood.image %>" alt="">
                <%= mood.label %>
            </a>
        <% }) %>
    </div>
</details>

<% const activeFilters = []; %>
<% if (activeMood) activeFilters.push(activeMood.label); %>
<% if (activeTag) activeFilters.push(activeTag.label); %>
<% if (q) activeFilters.push('"' + q + '"'); %>

<% if (activeFilters.length > 0) { %>
    <p class="filter-status">
        Showing: <strong><%= activeFilters.join(" + ") %></strong>
        <a href="/" aria-label="Clear filters">✕ Clear</a>
    </p>
<% } %>


<section class="feed">

    <% if (posts.length === 0) { %>
        <div class="feed-empty">
            <img src="/images/logo-and-dividers/empty-carton.png" alt="">
            <% if (activeMood || activeTag || q) { %>
                <p>Nothing matches that yet. <a href="/">Show everything</a></p>
            <% } else { %>
                <p>Nothing here yet. Be the first to write something.</p>
            <% } %>
        </div>
    <% } %>

    <% posts.forEach(post => { %>
        <article class="post-card <%= (post.mood) ? post.mood.colorClass : "" %> <%= (post.contentWarning) ? "post-card--warned" : "" %>">
            <div class="post-card__head">

                <% if (post.mood) { %>
                    <img class="post-card__sticker" src="<%= post.mood.image %>" alt="<%= post.mood.label %>">
                <% } %>

                <div>                    
                    <h2 class="post-card__title"><a href="/posts/<%= post.id %>"><%= post.title %></a></h2>
                    <time class="post-card__date"><%= post.createdAt.toLocaleDateString("en-GB", {dateStyle: "medium"}) %></time>
                </div>
            </div>
            
            
            <% if (post.contentWarning) {%>
                <p class="post-card__warning">Content warning: <%= post.contentWarning %></p>
            <% } else { %>
                <p class="post-card__preview"><%= post.body%></p>
            <% } %>

            <% const showTopics = !post.contentWarning && post.tags.length > 0; %>

            <div class="post-card__foot">
                <% if (post.timeTag || showTopics) { %>
                    <div class="post-card__tags">
                        <% if (post.timeTag) { %>
                            <span class="tag <%= post.timeTag.colorClass %>"><%= post.timeTag.label %></span>
                        <% } %>

                        <% if (showTopics) { %>
                            <% post.tags.forEach(tag => { %>
                                <a class="tag-link"
                                    href="/?tag=<%= tag.slug %><%= activeMood ? '&mood=' + activeMood.slug : '' %>"
                                    title="Show posts tagged <%= tag.label %>"
                                    aria-label="Show posts tagged <%= tag.label %>" <%- activeTag && activeTag.slug === tag.slug ? 'aria-current="page"' : '' %>>
                                    <span class="tag tag--topic <%= tag.colorClass %>"><%= tag.label %></span>
                                </a>
                            <% }) %>
                        <% } %>
                    </div>
                <% } %>
                <a class="btn" href="/posts/<%= post.id %>">Read more</a>
            </div>
            
        </article>
    <% }) %>

    
                
</section>

<%- include("./partials/footer.ejs") %>