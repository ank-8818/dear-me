<%- include("./partials/header.ejs") %>

<section class="intro">
  <h1>Food for thought</h1>
  <p><%= quote %></p>
</section>

<img class="divider" src="/images/assets/divider.svg" alt="">

<form class="search" action="/" method="GET" role="search">
    <input type="search" name="q" value="<%= q %>" maxlength="100" aria-label="Search posts" placeholder="Search thoughts">
    <% if (activeMood) { %> <input type="hidden" name="mood" value="<%= activeMood.slug %>"> <% } %>
    <% if (activeTag) { %> <input type="hidden" name="tag" value="<%= activeTag.slug %>"> <% } %>
    <button type="submit" class="btn">Search</button>
</form>

<details class="filter-panel">
    <summary>Filter by feelings</summary>

    <div class="mood-filter">
        <a class="chip" href="/" <%- !activeMood ? 'aria-current="page"' : "" %>>All</a>
        <% moods.forEach(mood => { %>
            <a class="chip" href="/?mood=<%= mood.slug %><%= activeTag ? '&tag=' + activeTag.slug : '' %>" <%- activeMood && activeMood.slug === mood.slug ? 'aria-current="page"' : "" %>>
                <img class="chip__sticker" src="<%= mood.image %>" alt="">
                <%= mood.label %>
            </a>
        <% }) %>
    </div>
</details>

<% const activeFilters = []; %>
<% if (activeMood) activeFilters.push(activeMood.label); %>
<% if (activeTag) activeFilters.push(activeTag.label); %>
<% if (q) activeFilters.push('"' + q + '"'); %>

<% if (activeFilters.length > 0) { %>
    <p class="filter-status">
        Showing: <strong><%= activeFilters.join(" + ") %></strong>
        <a href="/" aria-label="Clear filters">✕ Clear</a>
    </p>
<% } %>


<section class="feed">

    <% if (posts.length === 0) { %>
        <div class="feed-empty">
            <img src="/images/assets/empty-carton.png" alt="">
            <% if (activeMood || activeTag || q) { %>
                <p>Nothing matches that yet. <a href="/">Show everything</a></p>
            <% } else { %>
                <p>Nothing here yet. Be the first to write something.</p>
            <% } %>
        </div>
    <% } %>

    <% posts.forEach(post => { %>
        <%- include("./partials/post-card.ejs", { post }) %>
    <% }) %>

    <% if (nextPageUrl) {%>
        <div class="feed__more">
            <a class="btn" href="<%= nextPageUrl %>">More thoughts</a>
        </div>
    <% } %>

    
                
</section>

<script src="/js/load-more.js" defer></script>

<%- include("./partials/footer.ejs") %>