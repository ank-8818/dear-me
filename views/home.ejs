<%- include("./partials/header.ejs") %>

<section class="intro">
  <h1>Dear Me,</h1>
  <p>A place to pour it all out.</p>
</section>

<img class="divider" src="/images/logo-and-dividers/divider.svg" alt="">

<details class="filter-panel">
    <summary>Filter by feelings</summary>

    <div class="mood-filter">
        <a class="chip" href="/" <%- !activeMood ? 'aria-current="page"' : "" %>>All</a>
        <% moods.forEach(mood => { %>
            <a class="chip" href="/?mood=<%= mood.slug %>" <%- activeMood && activeMood.slug === mood.slug ? 'aria-current="page"' : "" %>>
                <img class="chip__sticker" src="<%= mood.image %>" alt="">
                <%= mood.label %>
            </a>
        <% }) %>
    </div>
</details>

<% if (activeMood) { %>
    <p class="filter-status">Showing: <strong><%= activeMood.label %></strong> <a href="/" aria-label="Clear filter">✕ Clear</a></p>
<% } %>

<section class="feed">

    <% if (posts.length === 0) { %>
        <p class="feed-empty">Nothing here yet. Be the first to write something.</p>
    <% } %>

    <% posts.forEach(post => { %>
        <article class="post-card <%= (post.mood) ? post.mood.colorClass : "" %>">
            <div class="post-card__head">

                <% if (post.mood) { %>
                    <img class="post-card__sticker" src="<%= post.mood.image %>" alt="<%= post.mood.label %>">
                <% } %>

                <div>                    
                    <h2 class="post-card__title"><a href="/posts/<%= post.id %>"><%= post.title %></a></h2>
                    <time class="post-card__date"><%= post.createdAt.toLocaleDateString("en-GB", {dateStyle: "medium"}) %></time>
                </div>
            </div>
            
            <p class="post-card__preview"><%= post.body%></p>
            <a class="btn" href="/posts/<%= post.id %>">Read more</a>
            
        </article>
    <% }) %>

    
                
</section>



<%- include("./partials/footer.ejs") %>