<%- include("./partials/header.ejs") %>

<article class="post-page">

    <div class="post-page__head">
        <% if (post.mood) { %>
            <img class="post-page__sticker" src="<%= post.mood.image %>" alt="<%= post.mood.label %>">
        <% } %>

        <div>
            <h1><%= post.title %></h1>
            <time class="post-card__date"><%= post.createdAt.toLocaleDateString("en-GB", {dateStyle: "medium"}) %></time>
            <% if (post.timeTag) { %>
                <span class="tag <%= post.timeTag.colorClass %>"><%= post.timeTag.label %></span>
            <% } %>
        </div>
    </div>

    <% if (post.contentWarning) {%>
        <details class="post-page__warning">
            <summary>Content warning: <%= post.contentWarning %>. <span class="post-page__show">Show post</span></summary>
            <p class="post-page__body"><%= post.body %></p>
            <%- include("./partials/topic-tags.ejs", { tags: post.tags }) %>
        </details>
    <% } else { %>
        <p class="post-page__body"><%= post.body %></p>
        <%- include("./partials/topic-tags.ejs", { tags: post.tags }) %>
    <% } %>

    <a class="btn" href="/">Back to all thoughts</a>
        
</article>

<%- include("./partials/footer.ejs") %>