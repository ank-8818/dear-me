<%- include("./partials/header.ejs") %>

<article class="post-page">

    <div class="post-page__head">
        <% if (post.mood) { %>
            <img class="post-page__sticker" src="<%= post.mood.image %>" alt="<%= post.mood.label %>">
        <% } %>

        <div>
            <h1><%= post.title %></h1>
            <%- include("./partials/byline.ejs", { post }) %>
            <% if (post.timeTag) { %>
                <span class="tag <%= post.timeTag.colorClass %>"><%= post.timeTag.label %></span>
            <% } %>
        </div>
    </div>

    <% if (post.isPrivate) { %>
        <p class="post-page__private" role="note">Only you can see this post.</p>
    <% } %>

    <% if (post.contentWarning) {%>
        <details class="post-page__warning">
            <summary>Content warning: <%= post.contentWarning %>. <span class="post-page__show">Show post</span></summary>
            <p class="post-page__body"><%= post.body %></p>
            <%- include("./partials/topic-tags.ejs", { tags: post.tags }) %>
        </details>
    <% } else { %>
        <p class="post-page__body"><%= post.body %></p>
        <%- include("./partials/topic-tags.ejs", { tags: post.tags }) %>
    <% } %>

    <% if (currentUser && currentUser.id === post.authorId) { %>
        <div class="post-page__actions">
            <a class="btn" href="/posts/<%= post.id %>/edit">Edit</a>

            <details class="delete-box">
                <summary>Delete</summary>
                <p>This can't be undone. Delete this post?</p>
                <form action="/posts/<%= post.id %>/delete" method="POST">
                    <button type="submit" class="btn btn--danger">Yes, delete it</button>
                </form>
            </details>
        </div>
    <% } %>
    <% if (currentUser && currentUser.id !== post.authorId && !post.isPrivate) { %>
        <p class="post-page__report"><a href="/posts/<%= post.id %>/report">Report this post</a></p>
    <% } %>

    <a class="btn" href="/">Back to all thoughts</a>
        
</article>

<%- include("./partials/footer.ejs") %>