<%- include("./partials/header.ejs") %>

<section class="compose">
    <% if (error) { %>
        <p class="form-error" role="alert"><%= error %></p>
    <% } %>

    <p class="register-intro">
        Enter your details and a new password below. We'll verify your recovery code to confirm it's really you.
    </p>

    <form action="/forgot-password" method="POST">
        <div class="field">
            <label for="pseudonym"> Pseudonym
                <input id="pseudonym" name="pseudonym" type="text" maxlength="20" required
                    value="<%= pseudonym %>" autocomplete="username">
            </label>
        </div>

        <div class="field">
            <label for="recoveryCode"> Recovery code
                <input id="recoveryCode" name="recoveryCode" type="text" required
                    autocomplete="off">
            </label>
        </div>

        <div class="field">
            <label for="password">New password
                <input id="password" name="password" type="password" minlength="8" required
                    autocomplete="new-password">
            </label>
        </div>

        <div class="field">
            <label for="confirmPassword">Confirm password
                <input id="confirmPassword" name="confirmPassword" type="password" minlength="8" required
                    autocomplete="new-password">
            </label>
        </div>

        <button type="submit" class="btn btn--solid">Reset password</button>
    </form>

</section>



<%- include("./partials/footer.ejs") %>