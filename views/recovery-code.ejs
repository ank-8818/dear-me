<%- include("./partials/header.ejs") %>

<section class="recovery-code">
    <h1>Your recovery code</h1>

    <p class="recovery-code__intro">
        This is the only way to go back in if you forget your password.
        Save it somewhere safe - a password manager, a note in your diary, even a piece of paper in your drawer. You won't see it again.
    </p>

    <div class="recovery-code__box">
        <code><%= code %></code>
    </div>

    <p class="recovery-code__hint">
        Click the code to select it, then copy. Screenshot it if that helps.
    </p>

    <a href="/" class="btn btn--solid">
        I've saved it - take me home
    </a>
</section>

<%- include("./partials/footer.ejs") %>